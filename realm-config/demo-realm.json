{
  "realm": "demo",
  "enabled": true,
  "displayName": "Demo Realm (interview prep)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "roles": {
    "realm": [
      { "name": "app_user",  "description": "Standard authenticated application user" },
      { "name": "app_admin", "description": "Administrative user with elevated privileges" }
    ]
  },

  "clients": [
    {
      "clientId": "product-service",
      "name": "Product Service (resource server)",
      "description": "Backend REST API. Validates tokens; does not initiate login.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "web-app",
      "name": "Web App (public SPA client)",
      "description": "Browser client. Authorization Code + PKCE. No client secret.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8081/*",
        "http://localhost:8082/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8081",
        "http://localhost:8082"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "product-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "product-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "backend-worker",
      "name": "Backend Worker (confidential, client credentials)",
      "description": "Machine-to-machine client. Client Credentials grant.",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "backend-worker-secret",
      "protocolMappers": [
        {
          "name": "product-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "product-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "order-service",
      "name": "Order Service (confidential, service account)",
      "description": "Resource server that also calls product-service via client-credentials (M2M).",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "order-service-secret",
      "protocolMappers": [
        {
          "name": "product-service-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "product-service",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "admin-service",
      "name": "Admin Service (manages identities via the Admin API)",
      "description": "Confidential client whose service account holds realm-management roles to CRUD users, roles and sessions.",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "admin-service-secret"
    }
  ],

  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@demo.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["app_user"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@demo.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["app_user", "app_admin"]
    },
    {
      "username": "service-account-order-service",
      "enabled": true,
      "serviceAccountClientId": "order-service",
      "realmRoles": ["app_user"]
    },
    {
      "username": "service-account-admin-service",
      "enabled": true,
      "serviceAccountClientId": "admin-service",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    }
  ]
}
