{
  "info": {
    "name": "Keycloak Interview Prep",
    "description": "Hands-on Keycloak Developer prep. One folder per module. Grows module by module.\n\nSetup: import this collection AND the environment file (postman/keycloak-local.postman_environment.json), then select the 'Keycloak Local' environment.\n\nToken requests auto-save the access_token to environment variables so downstream requests inherit it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Module 1 — Keycloak Bootstrap",
      "description": "Realm discovery, keys, and the machine-to-machine (client credentials) grant.",
      "item": [
        {
          "name": "OIDC Discovery (well-known)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/.well-known/openid-configuration",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", ".well-known", "openid-configuration"]
            },
            "description": "The OIDC discovery document. Every other endpoint (token, authz, jwks, userinfo, introspection, end-session) is advertised here. Point clients at this URL, not hard-coded paths."
          },
          "response": []
        },
        {
          "name": "JWKS (public signing keys)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/protocol/openid-connect/certs",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "certs"]
            },
            "description": "Public keys resource servers use to verify JWT signatures locally (no call to Keycloak per request). Refreshed by clients on key rotation."
          },
          "response": []
        },
        {
          "name": "Token — Client Credentials (backend-worker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.environment.set('m2m_access_token', json.access_token);",
                  "  pm.environment.set('access_token', json.access_token);",
                  "  console.log('Saved client-credentials token to {{access_token}} and {{m2m_access_token}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "backend-worker", "type": "text" },
                { "key": "client_secret", "value": "{{backendWorkerSecret}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Machine-to-machine grant. No user, no browser. The confidential client authenticates AS ITSELF using its secret and gets a token for its service account. Test script auto-saves the token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Module 2 — Resource Server (product-service)",
      "description": "A Spring Boot resource server that validates Keycloak JWTs and enforces roles.\n\nRun a token request first (it auto-saves {{access_token}}), then call the API. Use alice for read, bob for admin writes.\n\nNOTE: web-app has direct access grants (ROPC) enabled ONLY to make CLI/Postman testing easy. Real browser clients use Authorization Code + PKCE (Module 3).",
      "item": [
        {
          "name": "Token — Password Grant (alice / app_user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.access_token) { pm.environment.set('access_token', j.access_token); }",
                  "if (j.refresh_token) { pm.environment.set('refresh_token', j.refresh_token); }",
                  "console.log('Saved alice tokens');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{webAppClientId}}", "type": "text" },
                { "key": "username", "value": "alice", "type": "text" },
                { "key": "password", "value": "password", "type": "text" },
                { "key": "scope", "value": "openid", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Resource Owner Password Credentials grant (deprecated in OAuth2.1; enabled here only for easy testing). Gets alice's token (app_user role)."
          },
          "response": []
        },
        {
          "name": "Token — Password Grant (bob / app_admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.access_token) { pm.environment.set('access_token', j.access_token); }",
                  "if (j.refresh_token) { pm.environment.set('refresh_token', j.refresh_token); }",
                  "console.log('Saved bob tokens');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{webAppClientId}}", "type": "text" },
                { "key": "username", "value": "bob", "type": "text" },
                { "key": "password", "value": "password", "type": "text" },
                { "key": "scope", "value": "openid", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Gets bob's token (app_user + app_admin roles) for testing admin-only writes."
          },
          "response": []
        },
        {
          "name": "GET /api/products (any authenticated user)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{productServiceUrl}}/api/products",
              "host": ["{{productServiceUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Requires ROLE_app_user or ROLE_app_admin (@PreAuthorize). 401 without a token, 200 with alice or bob."
          },
          "response": []
        },
        {
          "name": "POST /api/products (app_admin only)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Webcam\",\n  \"category\": \"peripherals\",\n  \"price\": 59.99\n}"
            },
            "url": {
              "raw": "{{productServiceUrl}}/api/products",
              "host": ["{{productServiceUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Requires ROLE_app_admin. 403 with alice's token, 200 with bob's token. Demonstrates method-level authorization."
          },
          "response": []
        },
        {
          "name": "GET /api/products/whoami",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{productServiceUrl}}/api/products/whoami",
              "host": ["{{productServiceUrl}}"],
              "path": ["api", "products", "whoami"]
            },
            "description": "Echoes claims from the validated JWT (subject, username, audience, issuer). Proves the token was accepted and parsed."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Module 3 — OAuth2 / OIDC Flows",
      "description": "Every flow by hand. For the interactive Authorization Code + PKCE login, the easiest path in Postman is the request's Authorization tab (Type: OAuth 2.0, Grant: Authorization Code with PKCE). The requests below cover the token exchange, refresh, introspection and logout so you can run and read each step.\n\nRun order to see revocation: get tokens (Module 2 password grant, or the PKCE exchange) -> Introspect (active=true) -> Logout -> Introspect (active=false).",
      "item": [
        {
          "name": "1. Authorize — open login page (Auth Code + PKCE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/protocol/openid-connect/auth?client_id={{webAppClientId}}&response_type=code&scope=openid&redirect_uri=http://localhost:8081/callback&state=xyz123&code_challenge=CHALLENGE&code_challenge_method=S256",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "auth"],
              "query": [
                { "key": "client_id", "value": "{{webAppClientId}}" },
                { "key": "response_type", "value": "code" },
                { "key": "scope", "value": "openid" },
                { "key": "redirect_uri", "value": "http://localhost:8081/callback" },
                { "key": "state", "value": "xyz123" },
                { "key": "code_challenge", "value": "CHALLENGE" },
                { "key": "code_challenge_method", "value": "S256" }
              ]
            },
            "description": "Open this in a browser to see Keycloak's login page. After login it redirects to redirect_uri?code=... Copy that code into {{authCode}} and set {{codeVerifier}} to the verifier whose SHA-256 you put in code_challenge. (Or just use the Authorization tab's built-in PKCE.) The scripts/module-03/auth-code-pkce.sh does this whole dance headlessly."
          },
          "response": []
        },
        {
          "name": "2. Token — Authorization Code + PKCE (exchange)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const j = pm.response.json();",
              "if (j.access_token) pm.environment.set('access_token', j.access_token);",
              "if (j.refresh_token) pm.environment.set('refresh_token', j.refresh_token);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "authorization_code", "type": "text" },
              { "key": "client_id", "value": "{{webAppClientId}}", "type": "text" },
              { "key": "code", "value": "{{authCode}}", "type": "text" },
              { "key": "redirect_uri", "value": "http://localhost:8081/callback", "type": "text" },
              { "key": "code_verifier", "value": "{{codeVerifier}}", "type": "text" }
            ] },
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Exchanges the one-time code + code_verifier for tokens. The verifier proves the caller is the same party that started the flow (PKCE). Saves access + refresh tokens."
          },
          "response": []
        },
        {
          "name": "3. Refresh Token",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const j = pm.response.json();",
              "if (j.access_token) pm.environment.set('access_token', j.access_token);",
              "if (j.refresh_token) pm.environment.set('refresh_token', j.refresh_token);",
              "console.log('Rotated tokens saved');"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "grant_type", "value": "refresh_token", "type": "text" },
              { "key": "client_id", "value": "{{webAppClientId}}", "type": "text" },
              { "key": "refresh_token", "value": "{{refresh_token}}", "type": "text" }
            ] },
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Trades the refresh token for a fresh access token. Keycloak rotates the refresh token, so the old one becomes invalid."
          },
          "response": []
        },
        {
          "name": "4. Introspect Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "backend-worker", "type": "string" },
                { "key": "password", "value": "{{backendWorkerSecret}}", "type": "string" }
              ]
            },
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "token", "value": "{{access_token}}", "type": "text" }
            ] },
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/protocol/openid-connect/token/introspect",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token", "introspect"]
            },
            "description": "A confidential client asks Keycloak whether the token is active. Reflects revocation instantly (unlike local JWT validation). Returns active=false after logout."
          },
          "response": []
        },
        {
          "name": "5. Logout (end session)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "client_id", "value": "{{webAppClientId}}", "type": "text" },
              { "key": "refresh_token", "value": "{{refresh_token}}", "type": "text" }
            ] },
            "url": {
              "raw": "{{baseUrl}}/realms/{{realm}}/protocol/openid-connect/logout",
              "host": ["{{baseUrl}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "logout"]
            },
            "description": "Ends the SSO session and revokes the refresh token (204 No Content). Afterwards, Introspect shows active=false — but a locally-validated JWT would still pass until exp."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Module 4 — Gateway + Service-to-Service",
      "description": "All traffic goes through the gateway (:8090). The gateway validates the token at the edge and routes to product-service or order-service. order-service then calls product-service via token relay (/api/orders) or client credentials (/api/orders/sync).\n\nGet a token first (Module 2 password grant saves {{access_token}}).",
      "item": [
        {
          "name": "Gateway -> products (no token = 401 at edge)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/products",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "products"]
            },
            "description": "No Authorization header. The gateway rejects it at the edge with 401 before routing."
          },
          "response": []
        },
        {
          "name": "Gateway -> products (routed to product-service)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/products",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Gateway validates the token at the edge, then proxies to product-service (forwarding the Authorization header)."
          },
          "response": []
        },
        {
          "name": "Gateway -> orders (TOKEN RELAY)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/orders",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "order-service forwards YOUR token to product-service. Response 'mode' shows it called product-service as the logged-in user."
          },
          "response": []
        },
        {
          "name": "Gateway -> orders/sync (CLIENT CREDENTIALS)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/orders/sync",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "orders", "sync"]
            },
            "description": "order-service authenticates as its OWN service account (client_credentials) and calls product-service. Response 'mode' shows service-account 'order-service'."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Module 5 — Identity Lifecycle (Admin API)",
      "description": "admin-service (via the gateway) manages identities. You must call these as an app_admin (bob) — get bob's token with the Module 2 'Token — Password Grant (bob)' request first.\n\nFlow: Create user -> copy the returned id into {{newUserId}} -> Assign role -> Disable / Logout / Delete.",
      "item": [
        {
          "name": "Create user (JOINER)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "const j = pm.response.json();",
              "if (j.id) { pm.environment.set('newUserId', j.id); console.log('Saved newUserId=' + j.id); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"carol\",\n  \"email\": \"carol@demo.local\",\n  \"firstName\": \"Carol\",\n  \"lastName\": \"New\",\n  \"password\": \"carolpass\"\n}" },
            "url": {
              "raw": "{{gatewayUrl}}/api/admin/users",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "admin", "users"]
            },
            "description": "Provision a new user. Requires app_admin (bob). Saves the new id to {{newUserId}}."
          },
          "response": []
        },
        {
          "name": "List users (search)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/admin/users?search=carol",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [{ "key": "search", "value": "carol" }]
            }
          },
          "response": []
        },
        {
          "name": "Assign role app_user (MOVER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/admin/users/{{newUserId}}/roles/app_user",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "admin", "users", "{{newUserId}}", "roles", "app_user"]
            }
          },
          "response": []
        },
        {
          "name": "Disable user (LEAVER soft)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/admin/users/{{newUserId}}/disable",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "admin", "users", "{{newUserId}}", "disable"]
            }
          },
          "response": []
        },
        {
          "name": "Revoke sessions (LEAVER instant)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/admin/users/{{newUserId}}/logout",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "admin", "users", "{{newUserId}}", "logout"]
            }
          },
          "response": []
        },
        {
          "name": "Delete user (cleanup)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{gatewayUrl}}/api/admin/users/{{newUserId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["api", "admin", "users", "{{newUserId}}"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "note",
      "value": "Prefer the environment file for values. These are fallbacks.",
      "type": "string"
    }
  ]
}
